# Database
DATABASE_URL=data/sqlite.db

# Reserved for future auth (not used yet)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# LLM provider: 'openrouter' | 'openai' | 'anthropic' (default 'openrouter')
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Market prices: 'finnhub' | 'simulated' (default 'simulated')
PRICE_PROVIDER=simulated
FINNHUB_API_KEY=

# Asset allocations: Alpha Vantage → Yahoo Finance → DealCharts (fallback)
ALPHA_VANTAGE_API_KEY=
# Yahoo Finance works without an API key.
DEALCHARTS_API_KEY=
DEALCHARTS_BASE_URL=https://api.dealcharts.com
